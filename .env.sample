# Шаблон переменных окружения.
# Скопируйте файл в .env и подставьте свои значения:
#   copy .env.sample .env      (Windows)
#   cp .env.sample .env        (Linux/macOS)

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=skystore_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=127.0.0.1
DB_PORT=5432
